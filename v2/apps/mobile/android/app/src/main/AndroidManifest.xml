<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ⚠️ 这一行**必须在 main 里**，不能只靠 src/debug 与 src/profile 那两个 manifest。

         Flutter 模板只在后两者里声明 INTERNET（那是给 hot reload 用的），
         所以 **release 构建出来的包没有联网权限** —— 装到手机上会停在登录页，
         每个请求都失败，**而且不会有任何提示说是权限问题**。
         这个应用的全部功能都走网络（HTTPS + WSS 到调度器），所以它是必需项。

         ⚠️ **这个坑在本仓库里踩过两次**：
           第一次是旧 app（commit 3084b37 修好，还在那边留了同样的注释），
           第二次是 v2 全新重建时——因为"新写一遍"不会自动继承**教训**。
         ⇒ 所以现在有 `test/unit/android_manifest_test.dart` 守着它：
           **光靠注释挡不住第三次。**

         ⚠️ 改这段注释时注意：XML 注释里不能出现连续两个减号，否则整个 manifest 解析失败。 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 🔴 **录音那一条**（2026-09-28：主人 *"你帮我测试录音能力。"* ⇒ 原生那一份做出来了）：
         手册 **D5.11** 早就拍了板 —— 加 `RECORD_AUDIO`、**第一次按话筒才问权限**、
         **不申请后台录音**（`RECORD_BACKGROUND_AUDIO` 一个都不许有，V10 一票否决）。
         ⚠️ 问权限那一下在 `NativeRecorder.kt` 里（`start()` 那条路），
            不是启动时问 —— 判据：`scripts/check-apk.sh`（从包里核）＋
            `test/unit/android_manifest_test.dart`。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- 🔴 **桌面上显示的就是那个名字**（2026-09-28 改：原来是 Flutter 模板默认的
         `hupo_app` —— 装到手机上，桌面那一格就会写着 "hupo_app"，那是模板的残留、
         不是我们的名字）。判据：`test/unit/android_manifest_test.dart` 钉着它。
         ★ **2026-10-05 改成「琥珀聊天」**（主人：*「这次是2.0版本了……不要覆盖1.0。
         名字叫琥珀聊天」*）：1.0 那个 app 还叫「琥珀」、还装在他手机上 ⇒ 这一格必须
         **一眼分得开**是谁（名字与身份都不同，见 `app/build.gradle.kts` 的 `applicationId`）。

         ⚠️ **注释只能住在这里**（标签外面）：写进 `<application …>` 的属性之间
         就是**不合法的 XML** —— 2026-09-28 我自己这么写过一次，
         表现是 `flutter build apk` 当场报 "Please ensure that the android manifest
         is a valid XML document"（判据见那份测试里的"注释不许住进标签里"）。 -->
    <!-- 🔴 **圆形那一个也指上**（2026-09-28）：`mipmap-*/ic_launcher_round.png`（每档一张）
         与 `mipmap-anydpi-v26/ic_launcher_round.xml`（自适应那一套）都在；
         不指的话，会要圆图标的那几个启动器只能拿方的去裁。
         ⚠️ 属性写进标签里、**注释留在标签外** —— 写进标签中间就不是合法 XML 了（上面那条注释说的就是这件事）。 -->
    <application
        android:label="琥珀聊天"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
