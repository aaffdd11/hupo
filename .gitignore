# ── 依赖与构建产物 ──────────────────────────────────────────
node_modules/
**/.dart_tool/
**/build/
**/.packages
**/pubspec.lock.bak

# ── 运行时数据（**绝不能进仓库**）────────────────────────────
# 会话记录（主人的聊天）、鉴权文件（口令哈希 + 签名密钥）、监控报告
data/
*.jsonl
auth.json

# ── 申请补丁（助手提、主人签字；**不进仓库**）────────────────
# 两个理由：申请文件一被跟踪，仓库就永远有未提交改动 ⇒ `apply-change.sh` 的干净闸
# 会变成永远过不去；而且助手随手就能往仓库里塞东西，正是 P1 要堵的那条路。
proposals/

# ── 日志与临时文件 ─────────────────────────────────────────
*.log
*.tmp
.DS_Store
.idea/
*.iml
.vscode/

# v2 运行时数据与本地依赖
v2/services/core/node_modules/
v2/services/core/data/
v2/services/core/web/
v2/services/core/serve.pid
v2/services/core/serve.log
