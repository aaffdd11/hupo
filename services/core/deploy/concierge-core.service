# /etc/systemd/system/concierge-core.service
#
# ⚠ 这个文件里有两个**默认值**曾经把"一个子进程被 OOM"升级成"整个助理停机"（近 7 天实测 4 次）：
#   ① OOMPolicy 默认 stop：cgroup 里任一进程被 OOM ⇒ systemd 停掉**整个单元**（调度器 + 所有 agent 陪葬）
#      → Restart=always 3 秒后重启 → 启动对账把刚才那件重活原话重派 → 又 OOM。
#   ② StartLimitIntervalSec/Burst 默认 10s/5：配 RestartSec=3 时 3s×5=12s > 10s 窗口
#      ⇒ **永远凑不满 5 次**，systemd 自带的循环保护形同不存在。
#   现在两个都写出来了，别再删。
[Unit]
Description=Concierge Core（个人助理云端调度器）
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
# agent 是子进程，要能找到 nvm 里的 dsh
Environment=PATH=/home/deploy/.nvm/versions/node/v24.15.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Type=simple
User=deploy
WorkingDirectory=/home/deploy/projects/assistant/services/core
ExecStart=/home/deploy/.nvm/versions/node/v24.15.0/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# ── 资源上限 ─────────────────────────────────────────────────────────────
# MemoryMax 是硬限（到点杀）；MemoryHigh 是软限（先节流/回收，不直接杀）。
# 只设硬限 = 不做软性回收就直接 OOM。1 个活跃会话 + 一次 Flutter 构建 = 1086MB > 1024MB。
MemoryHigh=640M
MemoryMax=1G
MemorySwapMax=0
MemoryMin=256M
CPUQuota=150%

# 一个子进程被 OOM 就死它一个，调度器活着把这一轮如实收口（而不是整站变灰）
OOMPolicy=continue

# 全机 OOM 时别先杀我们（这台机器 7.2G / 0 swap，邻居不少）
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
