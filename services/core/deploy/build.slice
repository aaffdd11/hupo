# Hupo 构建专用 slice —— 把 Flutter 工具链从 concierge-core 的 cgroup 里挪出来。
#
# 为什么必须分开（实测）：1 个活跃会话（68+172MB）+ 一次构建（工具链 ~846MB）= 1086MB > 1024MB 上限
# ⇒ 必然 OOM。近 7 天实测 4 次，受害者每次都是 agent 自己起的 dart 前端编译器；
# 而 OOMPolicy 默认 stop 会把"一个构建进程死"升级成"整个助理停机 + 一次注定失败的重做"。
# CPU 也要分开：实测构建期间 nr_throttled/nr_periods = 9439/10428（90.5%），
# 主人的对话和构建抢同一份 CPU，直接把"首句 ≤6s"这条纪律打穿。
[Unit]
Description=Hupo 构建（Flutter 工具链）
Before=slices.target

[Slice]
MemoryMax=2G
CPUQuota=300%
CPUWeight=20
IOWeight=20
