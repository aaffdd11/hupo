+DIRTY="$(dirty_paths)"
+
+# ── 情况一：没给路径、也没说 --all ───────────────────────────
+PUSH_ONLY=0
+if [ "${#PATHS[@]}" = "0" ] && [ "$ALL" = "0" ]; then
+  if [ -n "$DIRTY" ]; then
+    echo "✗ 树上有未提交的改动，但你没说提交哪些 ⇒ **什么都没提交。**" >&2
+    echo "  · 只提交你自己那几个路径：" >&2
+    echo "      scripts/push-changes.sh \"说明\" -- <路径...>" >&2
+    echo "  · 确实要提交整棵树（先看清楚下面这些是不是都该进）：" >&2
+    echo "      scripts/push-changes.sh \"说明\" --all" >&2
