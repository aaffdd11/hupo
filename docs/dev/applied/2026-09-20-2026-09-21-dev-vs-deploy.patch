+      usage >&2
+      exit 2
+      ;;
+  esac
+done
+
+# ── 现在树上哪些路径是脏的（porcelain 前两列状态 + 一个空格之后是路径）──
+dirty_paths() {
+  git status --porcelain | while IFS= read -r line; do
+    p="${line:3}"
+    case "$p" in *' -> '*) p="${p##* -> }" ;; esac
+    printf '%s\n' "$p"
+  done
