+
+# ── 参数 ────────────────────────────────────────────────────
+if [ $# -eq 0 ]; then usage >&2; exit 2; fi
+MSG="$1"; shift
+
+PATHS=()
+ALL=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -h|--help) usage; exit 0 ;;
+    --all) ALL=1; shift ;;
+    --)
+      shift
+      while [ $# -gt 0 ]; do PATHS+=("$1"); shift; done
+      ;;
+    *)
